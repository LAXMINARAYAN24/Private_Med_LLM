# ==============================================================================
# MedShield AI — Environment Configuration Template
# Copy this file to '.env' and fill in your Hugging Face access token:
#   cp .env.example .env
# ==============================================================================

# Hugging Face Access Token
# Required to download the private checkpoints and Google MedGemma-4B-IT base weights.
# Generate your personal read token at: https://huggingface.co/settings/tokens
HF_TOKEN=your_hugging_face_token_here

# (Optional) Secondary alternative token
# HF_TOKEN_ALT=your_secondary_token_here

